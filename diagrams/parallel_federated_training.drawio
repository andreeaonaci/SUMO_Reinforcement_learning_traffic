<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="d1" name="Parallel federated training">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="&lt;b&gt;Parallel federated training — one round &lt;i&gt;r&lt;/i&gt;&lt;/b&gt;&lt;br&gt;python -m experiments.federated_training --parallel  (federated/parallel_server.py)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="-50" width="900" height="44" as="geometry"/></mxCell>
        <mxCell id="c3" value="Main process — ParallelFederatedServer.run()" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontSize=14;fontStyle=1;fontColor=#AA4A85;strokeColor=#AA4A85;fillColor=#F6E6EF;strokeWidth=2;verticalAlign=top;spacingTop=6;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1500" height="230" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;① Global model θ&lt;sup&gt;(r)&lt;/sup&gt;&lt;/b&gt;&lt;br&gt;DQNAgent (same class as the workers)&lt;br&gt;sent to every city" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#AA4A85;fillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="c3"><mxGeometry x="30" y="70" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;④ Aggregate&lt;/b&gt; (aggregate_round)&lt;br&gt;FedAvg, weighted by sample count:&lt;br&gt;θ&lt;sup&gt;(r+1)&lt;/sup&gt; = Σ&lt;sub&gt;c&lt;/sub&gt; n&lt;sub&gt;c&lt;/sub&gt; θ&lt;sub&gt;c&lt;/sub&gt; / Σ&lt;sub&gt;c&lt;/sub&gt; n&lt;sub&gt;c&lt;/sub&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;other strategies: --aggregation_strategy&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#AA4A85;fillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="c3"><mxGeometry x="420" y="70" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;⑤ Evaluate&lt;/b&gt; (HoldoutEvaluator)&lt;br&gt;θ&lt;sup&gt;(r+1)&lt;/sup&gt; on the held-out city (grid4x4)&lt;br&gt;greedy, no training there&lt;br&gt;&lt;font style='font-size:10px'&gt;every --eval_every rounds, --eval_episodes episodes&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#666666;fillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="c3"><mxGeometry x="800" y="70" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;⑥ Save&lt;/b&gt;&lt;br&gt;global_round_r.pth&lt;br&gt;federated_history.json" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#666666;fillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="c3"><mxGeometry x="1160" y="70" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="c8" value="θ&lt;sup&gt;(r+1)&lt;/sup&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontSize=12;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c9" value="metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontSize=12;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c10" value="next round: r ← r + 1, θ&lt;sup&gt;(r+1)&lt;/sup&gt; becomes the model to send" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontSize=12;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#AA4A85;fontColor=#AA4A85;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="c7" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1350" y="105"/><mxPoint x="180" y="105"/></Array></mxGeometry></mxCell>
        <mxCell id="c11" value="Worker process — arterial4x4  (started once, lives for the whole run)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontSize=14;fontStyle=1;fontColor=#0072B2;strokeColor=#0072B2;fillColor=#DCEBF5;strokeWidth=2;verticalAlign=top;spacingTop=6;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="480" height="440" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;b&gt;② agent.start_round(θ&lt;sup&gt;(r)&lt;/sup&gt;)&lt;/b&gt;: load the global weights.&lt;br&gt;Replay buffer, optimizer and ε schedule are kept from earlier rounds." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#AA4A85;fillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="c11"><mxGeometry x="20" y="45" width="440" height="55" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;b&gt;SUMO environment&lt;/b&gt; (kept warm)&lt;br&gt;+ ActionMaskPadder&lt;br&gt;+ CommDropoutWrapper" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#0072B2;fillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="c11"><mxGeometry x="20" y="130" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;b&gt;③ Local DQNAgent&lt;/b&gt;&lt;br&gt;model θ&lt;sub&gt;c&lt;/sub&gt;, ε-greedy&lt;br&gt;E = --local_episodes episodes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#B87A00;fillColor=#FBF0D6;strokeWidth=1.5;" vertex="1" parent="c11"><mxGeometry x="270" y="130" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;b&gt;Replay buffer&lt;/b&gt; (10 000)&lt;br&gt;stays in this process" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#009E73;fillColor=#DDF2EC;strokeWidth=1.5;" vertex="1" parent="c11"><mxGeometry x="20" y="265" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;b&gt;optimize()&lt;/b&gt; each step&lt;br&gt;batch 64, Double DQN target,&lt;br&gt;Huber loss, grad clip 10,&lt;br&gt;target net: Polyak τ = 0.005" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#B87A00;fillColor=#FBF0D6;strokeWidth=1.5;" vertex="1" parent="c11"><mxGeometry x="270" y="260" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="c17" value="After E episodes: send back θ&lt;sub&gt;c&lt;/sub&gt;, n&lt;sub&gt;c&lt;/sub&gt; (samples), mean loss, action counts; decay lr" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#AA4A85;fillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="c11"><mxGeometry x="20" y="375" width="440" height="45" as="geometry"/></mxCell>
        <mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontSize=12;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.784;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c19" value="observation, reward" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;fontFamily=Helvetica;fontSize=12;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
